generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Listing {
  id        String   @id @default(uuid())
  sourceUrl String   @unique
  title     String
  price     String
  rating    String?
  location  String?
  host      String?
  amenities String?
  rawHtml   String?
  scraperId String?
  scrapedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scraperRun ScraperRun? @relation(fields: [scraperId], references: [id])
}

model ScraperRun {
  id           String    @id @default(uuid())
  name         String
  status       String
  itemsScraped Int       @default(0)
  itemsFailed  Int       @default(0)
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  errorMessage String?

  listings Listing[]
}
