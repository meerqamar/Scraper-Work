# Database
DATABASE_URL="postgresql://postgres:meer@localhost:5432/scraper_db"

# Target site
TARGET_BASE_URL="https://www.airbnb.com"
TARGET_DOMAIN="airbnb.com"

# Bot identification
BOT_NAME="WorkshopScraperBot"
BOT_EMAIL="admin@example.com"
BOT_VERSION="1.0.0"

# Timeouts and rate limiting
REQUEST_TIMEOUT_MS=30000
RATE_LIMIT_DELAY_MS=1000
MAX_CONCURRENT_REQUESTS=2
MAX_RETRIES=3

# Logging
LOG_LEVEL="info"
